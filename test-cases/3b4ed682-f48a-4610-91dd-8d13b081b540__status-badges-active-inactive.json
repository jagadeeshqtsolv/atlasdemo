{
  "id": "status-badges-active-inactive",
  "testPlanId": "3b4ed682-f48a-4610-91dd-8d13b081b540",
  "requirementId": "7f203695-9ee4-4032-80a3-d1b50786b850",
  "suiteName": "Admin User Management — Smoke",
  "case": {
    "id": "status-badges-active-inactive",
    "title": "Status cell shows green Active and red Inactive badges for respective users",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Admin base URL",
        "value": "https://qa-atlas.qtsolvdev.com/admin"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Click Salesforce login",
        "locatorHint": "[data-testid='salesforce-login-btn']"
      },
      {
        "id": "s3",
        "action": "waitForVisible",
        "targetDescription": "Wait for table rows",
        "locatorHint": "[data-testid='user-row']",
        "value": "10000"
      },
      {
        "id": "s4",
        "action": "assertCountGreaterThan",
        "targetDescription": "At least one Active badge exists",
        "locatorHint": "[data-testid='status-badge'][data-status='active']"
      },
      {
        "id": "s5",
        "action": "assertCountGreaterThan",
        "targetDescription": "At least one Inactive badge exists",
        "locatorHint": "[data-testid='status-badge'][data-status='inactive']"
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
}
