{
  "id": "search-case-insensitive-email-fragment",
  "testPlanId": "3b4ed682-f48a-4610-91dd-8d13b081b540",
  "requirementId": "7f203695-9ee4-4032-80a3-d1b50786b850",
  "suiteName": "Admin User Management — Smoke",
  "case": {
    "id": "search-case-insensitive-email-fragment",
    "title": "Search is case-insensitive for email fragments ('com' vs 'COM')",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Admin base URL",
        "value": "https://qa-atlas.qtsolvdev.com/admin"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Click Salesforce login",
        "locatorHint": "[data-testid='salesforce-login-btn']"
      },
      {
        "id": "s3",
        "action": "waitForVisible",
        "targetDescription": "Wait for search input",
        "locatorHint": "[data-testid='user-search']",
        "value": "10000"
      },
      {
        "id": "s4",
        "action": "fill",
        "targetDescription": "Type 'com' in Search user",
        "locatorHint": "[data-testid='user-search']",
        "value": "com"
      },
      {
        "id": "s5",
        "action": "wait",
        "targetDescription": "Wait for filtering",
        "value": "400"
      },
      {
        "id": "s6",
        "action": "assertCountGreaterThan",
        "targetDescription": "Results present for 'com'",
        "locatorHint": "[data-testid='user-row']"
      },
      {
        "id": "s7",
        "action": "clear",
        "targetDescription": "Clear search input",
        "locatorHint": "[data-testid='user-search']"
      },
      {
        "id": "s8",
        "action": "fill",
        "targetDescription": "Type 'COM' in Search user",
        "locatorHint": "[data-testid='user-search']",
        "value": "COM"
      },
      {
        "id": "s9",
        "action": "wait",
        "targetDescription": "Wait for filtering",
        "value": "400"
      },
      {
        "id": "s10",
        "action": "assertCountGreaterThan",
        "targetDescription": "Results present for 'COM'",
        "locatorHint": "[data-testid='user-row']"
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
}
